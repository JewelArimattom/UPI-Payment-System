# Copy this file to `.env` (local dev) or set these in Vercel project settings

# MongoDB Atlas connection string (SRV)
MONGODB_URI=

# Cloudinary credentials (required on serverless for screenshot uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Comma-separated list of allowed origins for CORS
# Include localhost for dev and your deployed frontend(s); no trailing slashes
CORS_ORIGIN=http://localhost:5173, https://upi-payment-system-kappa.vercel.app, https://upi-payment-system.vercel.app

# Optional: log CORS decisions to server logs
DEBUG_CORS=1
